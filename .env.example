# 복사해서 .env.local로 쓰기 (cp .env.example .env.local). 실제 값은 커밋하지 말 것.
# 배포 환경은 Vercel 프로젝트 설정 > Environment Variables에 같은 이름으로 등록.

# 카카오 디벨로퍼스 > 앱 > 플랫폼 키 > REST API 키 (앱의 카카오맵 사용 설정 ON 필요)
KAKAO_REST_API_KEY=

# OpenRouter > Settings > Keys. 비워두면 LLM 없이 규칙 기반 추출 + 템플릿 문구로 동작
# (무료 한도는 계정 단위라 로컬 테스트가 운영 한도를 함께 씀)
OPENROUTER_API_KEY=

# 시도할 모델 순서 (쉼표 구분)
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free

# 갤러리 게시 서명 키 — 임의의 긴 문자열 (예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
GALLERY_SIGNING_SECRET=

# Upstash Redis (Vercel Storage 연동 시 자동 주입). 로컬에서 비워두면 개발 서버만 메모리 저장소 사용
KV_REST_API_URL=
KV_REST_API_TOKEN=
